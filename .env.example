# Salin menjadi .env lalu isi nilainya. Jangan commit file .env.
# Koneksi database via PgBouncer (dibaca otomatis oleh node-postgres).
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# Rahasia untuk menandatangani JWT (string acak panjang).
JWT_SECRET=

# Akun super admin awal (dipakai script seed saat pertama kali jalan).
ADMIN_EMAIL=
ADMIN_PASSWORD=

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
