# ===== Salin ke .env lalu ubah semua nilai CHANGE_ME =====
# Produksi (docker-compose.yml): menempel ke infra repo devops. Host = NAMA CONTAINER di network global-gateway-net.
# Database + user dibuat oleh:  devops/scripts/create-app-db.sh portfolio   (mencetak 2 baris URL di bawah)

# Lewat PgBouncer (transaction mode) — dipakai aplikasi
DATABASE_URL=postgres://portfolio:CHANGE_ME@infra_pgbouncer:5432/portfolio
# Langsung ke Postgres — khusus migrasi
DATABASE_URL_DIRECT=postgres://portfolio:CHANGE_ME@infra_postgres:5432/portfolio
DB_POOL_MAX=5

# true jika diakses lewat HTTPS (WAJIB true di produksi)
COOKIE_SECURE=true
SESSION_TTL_DAYS=7
TZ_APP=Asia/Jakarta

# Super admin pertama — hanya dibuat saat migrate jika belum ada user ber-role sistem
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_min8chars

# ===== Dev lokal (docker-compose.dev.yml) =====
# DATABASE_URL=postgres://portfolio:dev@127.0.0.1:6432/portfolio
# DATABASE_URL_DIRECT=postgres://portfolio:dev@127.0.0.1:5432/portfolio
# COOKIE_SECURE=false
