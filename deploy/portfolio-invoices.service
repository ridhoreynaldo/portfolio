[Unit]
Description=Portfolio - terbitkan tagihan bulanan otomatis (Leetcloud)
After=portfolio.service
Requires=portfolio.service

[Service]
Type=oneshot
User=portfolio
Group=portfolio
EnvironmentFile=/etc/portfolio/app.env
ExecStart=/usr/bin/curl -fsS -m 60 -X POST -H "Authorization: Bearer ${CRON_SECRET}" http://127.0.0.1:3200/api/cron/invoices
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
